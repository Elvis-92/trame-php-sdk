{
    "name": "trame/trame-php",
    "description": "PHP client for the Trame API",
    "type": "library",
    "license": "MIT",
    "keywords": ["trame", "api", "sdk", "payments", "finance"],
    "homepage": "https://github.com/Elvis-92/trame-php-sdk",
    "support": {
        "issues": "https://github.com/Elvis-92/trame/issues",
        "source": "https://github.com/Elvis-92/trame-php-sdk"
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Trame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trame\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
